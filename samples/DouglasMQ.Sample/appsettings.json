{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DouglasMQ": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",

  "DouglasMQ": {
    "HostName": "localhost",
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ClientProvidedName": "douglasmq-sample",
    "PrefetchCount": 10,
    "RetryCount": 3,
    "RetryDelayMs": 200,
    "PublisherConfirms": true
  },

  "Otlp": {
    "Endpoint": "http://localhost:5341/ingest/otlp",
    "ApiKey": "",
    "MetricsExporter": "Console",
    "ConsoleTraces": false
  },

  "Sample": {
    "AutoPublishIntervalSeconds": 5,
    "FailureRate": 0.25,
    "PoisonRate": 0.05
  }
}
