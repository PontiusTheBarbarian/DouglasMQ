<Project>
	<PropertyGroup>
		<Authors>Liam Appleyard</Authors>
		<Company>Goodboy</Company>
		<IsPackable>false</IsPackable>
		<Copyright>Copyright © 2022-2026 Goodboy</Copyright>
		<!-- Versions are supplied by GitVersion in CI (see build/Build.cs). Local builds use the SDK default. -->
		<!-- GitVersion's InformationalVersion already includes the commit SHA. -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

		<!-- Use the latest C# language features across all projects -->
		<LangVersion>latest</LangVersion>

		<!-- Ensures byte-for-byte reproducible builds locally and in CI -->
		<Deterministic>true</Deterministic>

		<!-- In CI (when CI env var is set) lock down source paths for fully reproducible packages -->
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<ItemGroup>
		<AdditionalFiles Include="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), DouglasMQ.sln))\stylecop.json" Link="stylecop.json" />
	</ItemGroup>
	<PropertyGroup>
		<CodeAnalysisRuleSet>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), DouglasMQ.sln))\DouglasMQ.ruleset</CodeAnalysisRuleSet>
	</PropertyGroup>
	<PropertyGroup Condition="'$(BuildingInsideVisualStudio)' != 'true'">
		<!-- Ideally this is always enabled, but that tends to hurt developer productivity -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
</Project>